  "engines": {
    "npm": ">=11.10.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build && tsc -b",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm run prettier && npm run lint && npm run test",
    "check:fix": "npm run build && npm run prettier:fix && npm run lint:fix && npm run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-router": "^1.170.23",
