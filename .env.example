# Copy to .env. Both services read this file (services/api via its Makefile,
# services/web via Vite's envDir).

ENVIRONMENT_NAME=local
LOG_LEVEL=info

# Unusual ports, chosen not to collide with anything else running locally.
# Each service binds exactly the port it is given and fails if that port is
# taken; nothing quietly moves to another one.
API_HTTP_PORT=39170
WEB_PORT=39171

API_PREFIX=
ENABLE_PPROF=false

# Browser origins allowed to open a realtime socket. A WebSocket is not
# covered by CORS, so this is the only thing between a page on another site
# and this server. Comma-separated; there is no wildcard default.
ALLOWED_ORIGINS=http://localhost:39171,http://127.0.0.1:39171

# The .oma workspace: everything the running system stores, as opposed to
# the deploy-time values in this file. Defaults to the user's home, so every
# project on a machine shares one workspace. "~" is expanded by the app, and
# a relative path is resolved against the directory the process starts in.
#
# To inspect the workspace in an IDE, point it at the repo with an ABSOLUTE
# path — the api runs from services/api, so a relative one would land there
# rather than beside this file:
#
#   OMA_HOME=/absolute/path/to/oh-my-agents/.oma
#
# .oma is gitignored, so nothing it holds is ever committed.
OMA_HOME=~/.oma

# Realtime fan-out between api processes (ADR-0008). Leave VALKEY_URL empty to
# use the in-memory bus, which needs nothing installed and is correct for a
# single process. Set it only when running more than one.
#
# The port is deliberately not the Redis default, so an unrelated instance
# already running on this machine cannot be joined by accident.
VALKEY_PORT=39172
VALKEY_URL=

VITE_API_URL=http://localhost:39170
